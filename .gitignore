# System files
.DS_Store
Thumbs.db

# Dependencies
node_modules/

# Build output
dist/
build/

# Package-manager caches
.pnpm-store/

# Local env and secrets
.env
.env.*
!.env.example

# Generated files
vite.config.*.timestamp-*

# TypeScript
*.tsbuildinfo

# Testing & coverage
coverage/
coverage-visual/
.nyc_output/
*.lcov
playwright-report/
test-results/
.vitest/
benchmark-results.json
benchmark-baseline.json
benchmark-comparison.json
benchmark-comparison.md

# Claude Code (skills, rules, settings.json are tracked)
.claude/settings.local.json
.claude/memory/
.claude/worktrees/
.claude/scheduled_tasks.*
.claude/launch.json

# MCP configs – nested/local ones may carry secrets; the root file is tracked and secret-free
.mcp.json
mcp.json
!/.mcp.json

# IDE and editor files
.vscode/
.idea/
*.iml
.zed/*
!.zed/settings.json
*.swp
*.swo
*~

# Logs and scratch
*.log
pnpm-debug.log*
.remember/

# Cache
.eslintcache
.cache/
.knip-output.json

# Temporary folders
tmp/
temp/

# Cross-process build locks (scripts/build-lock.mjs, used by ensure-engine-built.mjs and
# ensure-kit-built.mjs) – created and removed at runtime; a crashed process can leave one behind
/.ensure-engine-built.lock/
/.ensure-kit-built.lock/

# Superpowers skill scratch (task briefs, review diffs, progress ledger)
.superpowers/
docs/superpowers/

# Local security run reports (MCP preflight / governance)
security-reports/

# Scaffolder ownership manifest and pristine kit copies (create-blit386 test fixtures,
# generated games). Never reformat .blit/base/ - it makes `blit agents sync` report
# drift on files nobody edited.
.blit/

# Output of 'npm pack'
*.tgz

# Husky runtime
.husky/_/
