#!/bin/sh

. "$(dirname "$0")/ensure-pnpm.sh"
. "$(dirname "$0")/check-author.sh"

echo "Running pre-push checks..."
echo ""

# Prints how long a command took, then returns its own exit status. Whole seconds
# only (POSIX date has no sub-second format); good enough to spot the slow phase.
# Safe under `sh -e`: every call site below is part of an || or && list.
PUSH_START=$(date +%s)
timed() {
    _label=$1
    shift
    _t0=$(date +%s)
    "$@"
    _rc=$?
    echo "[timing] $_label: $(($(date +%s) - _t0))s"
    return $_rc
}

# Reject any commit about to be pushed whose author/committer is a placeholder
# identity (see check-author.sh). Catches commits that bypassed pre-commit -
# rebase, cherry-pick, amend --no-verify, or a commit made in another
# worktree/session with a bad local .git/config override.
ZERO_SHA="0000000000000000000000000000000000000000"
AUTHOR_SCAN_START=$(date +%s)
# The tip being pushed, which is not necessarily HEAD: `git push origin other-branch`
# from a different checkout pushes other-branch. One pushed ref -> filter on its sha;
# several -> no single range describes them, so every package runs (see below).
PUSH_TIP="HEAD"
PUSH_BASE=""
PUSH_COUNT=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO_SHA" ] && continue # deleting the remote ref

    PUSH_TIP=$local_sha
    PUSH_COUNT=$((PUSH_COUNT + 1))

    if [ "$remote_sha" = "$ZERO_SHA" ]; then
        # Only commits no remote ref has yet, not the whole history.
        push_range="$local_sha --not --remotes"
    else
        push_range="$remote_sha..$local_sha"
        # The remote's current tip is the exact base of what this push adds; the branch's
        # upstream can name a different branch. Unknown locally (never fetched) -> fall back.
        if git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
            PUSH_BASE=$remote_sha
        fi
    fi

    # Written to a temp file rather than piped into the while loop: a piped
    # while runs in a subshell, so check_author_identity's `exit 1` would only
    # kill the subshell and the push would proceed anyway.
    author_log=$(mktemp)
    # $push_range is deliberately unquoted: it may carry the extra --not --remotes args.
    # shellcheck disable=SC2086
    git log $push_range --format='%H%x09%an%x09%ae%x09%cn%x09%ce' >"$author_log"
    while IFS="$(printf '\t')" read -r sha an ae cn ce; do
        check_author_identity "$an" "$ae" "Commit $sha author"
        check_author_identity "$cn" "$ce" "Commit $sha committer"
    done <"$author_log"
    rm -f "$author_log"
done
echo "[timing] author scan: $(($(date +%s) - AUTHOR_SCAN_START))s"

if [ "$PUSH_COUNT" -eq 0 ]; then
    echo "Only ref deletions to push; nothing to check."
    exit 0
fi

# Monorepo: dispatch preflight per changed package rather than running everything.
# pnpm 12 dropped the two-ref "[ref...tip]" changed-since selector (its "[since]" filter
# now takes one ref and diffs against the working tree, uncommitted changes included) -
# so the committed range is computed by hand with `git diff --name-only ref tip` and fed
# to pnpm's static "...{dir}" selector (that package plus anything downstream of it) per
# changed package directory. Only committed work is being pushed, so only committed work
# is checked; every package has a "preflight" script today, and --if-present keeps a
# future one without it from failing. --if-present
# must come BEFORE "run": placed after the script name, pnpm forwards it as an
# argument to the script's own command chain instead of consuming it itself - for
# a package whose preflight ends in "&& pnpm run build", that appends a stray
# "--if-present" to the build command, which the underlying build tool then
# rejects as an unknown flag.
#
# Husky's wrapper runs this script with `sh -e`, so every command whose failure
# is intentionally tolerated below is guarded with `|| true` or `|| VAR=$?` -
# under -e, a bare failing command inside a plain assignment or statement (not
# itself an if/&&/|| condition) aborts the whole script immediately, which on a
# first push (no upstream yet) killed this hook before the origin/main fallback,
# and on a real preflight failure skipped the "[FAIL]" message entirely.
UPSTREAM_REF=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
# One pushed ref with a known remote tip -> diff against that tip; otherwise the
# branch's upstream, then origin/main.
BASE_REF="${UPSTREAM_REF:-origin/main}"
if [ "$PUSH_COUNT" -eq 1 ] && [ -n "$PUSH_BASE" ]; then
    BASE_REF=$PUSH_BASE
fi

if ! git rev-parse --verify --quiet "$BASE_REF" >/dev/null 2>&1; then
    if git rev-parse --verify --quiet "HEAD~1" >/dev/null 2>&1; then
        BASE_REF="HEAD~1"
    else
        BASE_REF=""
    fi
fi

# Git exports GIT_DIR (and its siblings) into every hook, pointing at the git dir
# of the worktree being pushed from. Those variables outrank cwd, so any git
# subprocess a preflight step spawns for some *other* directory - a throwaway
# fixture repo in node --test, a `git -C <path> log` - silently retargets this
# repository instead. `git init` under a linked worktree's GIT_DIR is the
# destructive case: git cannot pair that git dir with a work tree from an
# unrelated cwd, so it writes `bare = true` into the shared .git/config and every
# later git command in every checkout fails with "this operation must be run in a
# work tree" until someone resets it by hand.
#
# `git rev-parse --local-env-vars` is git's own list of what to clear before
# recursing into an unrelated repository, so it stays correct as git grows new
# ones; the three appended by hand scope discovery and ref visibility rather than
# repo location, and are set on hook subprocesses all the same. The hook's own git
# usage above is finished by this point, and every command below runs with the repo
# root as cwd, so plain discovery is what we want. Call sites scrub these too
# (scripts/lib/git-env.mjs); this is the containment that also covers
# preflight steps nobody has written yet.
GIT_LOCAL_ENV_VARS=$(git rev-parse --local-env-vars 2>/dev/null || true)
if [ -n "$GIT_LOCAL_ENV_VARS" ]; then
    # Intentionally unquoted: the variable holds a newline-separated list of names.
    # shellcheck disable=SC2086
    unset $GIT_LOCAL_ENV_VARS
fi
unset GIT_LOCAL_ENV_VARS GIT_CEILING_DIRECTORIES GIT_NAMESPACE GIT_QUARANTINE_PATH

PREFLIGHT_STATUS=0
if [ -n "$BASE_REF" ] && [ "$PUSH_COUNT" -gt 1 ]; then
    echo "Pushing $PUSH_COUNT refs; running preflight for every package..."
    timed "package preflight" pnpm -r --if-present run preflight || PREFLIGHT_STATUS=$?
elif [ -n "$BASE_REF" ]; then
    echo "Running preflight for packages changed since $BASE_REF..."
    CHANGED_PACKAGE_DIRS=$(git diff --name-only "$BASE_REF" "$PUSH_TIP" -- packages 2>/dev/null | awk -F/ '{print $1 "/" $2}' | sort -u)
    FILTER_ARGS=""
    for dir in $CHANGED_PACKAGE_DIRS; do
        FILTER_ARGS="$FILTER_ARGS --filter ...{$dir}"
    done
    if [ -n "$FILTER_ARGS" ]; then
        # $FILTER_ARGS is deliberately unquoted: each token is one of our own
        # "--filter ...{packages/x}" pairs, never user input.
        # shellcheck disable=SC2086
        timed "package preflight" pnpm $FILTER_ARGS --if-present run preflight || PREFLIGHT_STATUS=$?
    else
        echo "No package changes since $BASE_REF; skipping package preflight."
    fi
else
    echo "No valid base ref (neither upstream/origin/main nor HEAD~1); running preflight for every package..."
    timed "package preflight" pnpm -r --if-present run preflight || PREFLIGHT_STATUS=$?
fi

# The package-preflight dispatch above only looks at files under packages/*, so a push
# that changes nothing there (root CLAUDE.md, .claude/, .husky/, root scripts/, root
# configs) would otherwise run zero checks. Always run the root-level gate too.
if [ "$PREFLIGHT_STATUS" -eq 0 ]; then
    echo "Running root-level checks (format:check, docs:links, agents:check, sync:cursor-commands:check, sync:maintainer-agents:check, audit:modules:check, bump:check, spellcheck:kit, test:root)..."
    timed "format:check" pnpm run format:check &&
        timed "docs:links" pnpm run docs:links &&
        timed "agents:check" pnpm run agents:check &&
        timed "sync:cursor-commands:check" pnpm run sync:cursor-commands:check &&
        timed "sync:maintainer-agents:check" pnpm run sync:maintainer-agents:check &&
        timed "audit:modules:check" pnpm run audit:modules:check &&
        timed "bump:check" pnpm run bump:check &&
        timed "spellcheck:kit" pnpm run spellcheck:kit &&
        timed "test:root" pnpm run test:root || PREFLIGHT_STATUS=$?
fi

if [ "$PREFLIGHT_STATUS" -ne 0 ]; then
    echo ""
    echo "[FAIL] Preflight checks failed. Fix issues above before pushing."
    exit 1
fi

echo ""
echo "Pre-push checks passed! Ready to push. (total $(($(date +%s) - PUSH_START))s)"

# Advisory only - never fails the push. Reminds when this push touches an engine
# hot-path directory (see packages/blit386/.claude/rules/bench-coverage.md) without
# touching any *.bench.ts file (push-wide, not per-file - see check-bench-coverage.mjs),
# since CI does not run or gate on benchmarks and it is easy to forget the local
# baseline/compare workflow.
if [ -n "$BASE_REF" ] && [ -f "packages/blit386/scripts/check-bench-coverage.mjs" ]; then
    node packages/blit386/scripts/check-bench-coverage.mjs --base "$BASE_REF"
fi
