# Prettier ignore - Markdown and YAML only (TS/JS/JSON/CSS use Biome)

# Lock files (never format)
pnpm-lock.yaml
package-lock.json
yarn.lock

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/

# Agent scratch space (not ours to format)
.git/
.remember/
.superpowers/

# Scaffolder ownership manifest and pristine kit copies (create-blit386). Reformatting
# .blit/base/ makes `blit agents sync` report drift on files nobody edited.
.blit/

# Generated/minified files
**/*.min.css
vite.config.*.timestamp-*

# JSON is handled by Biome
*.json

# packages/demos: HTML pages use Handlebars syntax, Prettier would break them
*.html

# packages/docs-site: Waku/fumadocs-mdx codegen output
.source/

# packages/docs-site: generated docs mirror (produced by
# packages/docs-site/scripts/sync-docs-from-engine.mjs from packages/blit386/docs).
# Artifacts: not subject to this repo's format gate. The hand-authored hub
# (content/docs/index.mdx) and root meta stay formatted.
packages/docs-site/content/docs/*/**
