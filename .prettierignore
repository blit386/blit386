# Prettier ignore - Prettier owns only md/mdx/mdc/yml/yaml (JS/TS/JSON/CSS use Biome)

# Lock file (never format)
pnpm-lock.yaml

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/

# Test runner output (generated locally by `test:visual`, gitignored). Formatting
# these makes the next format:check fail on files nobody authored.
playwright-report/
test-results/

# Agent scratch space (not ours to format)
.git/
.remember/
.superpowers/

# Scaffolder ownership manifest and pristine kit copies (create-blit386). Reformatting
# .blit/base/ makes `blit agents sync` report drift on files nobody edited.
.blit/

# Every Prettier script globs only md/mdx/mdc/yml/yaml, but a directory-level run (an
# editor, `prettier --write .github`) would still reformat these: every Biome-owned
# extension (Prettier lays out JS/TS differently, so it reflows files Biome already
# passes), JSON in particular includes byte-checked generated files
# (.github/hooks/blit.json), and the demos' HTML pages use Handlebars syntax Prettier
# breaks.
*.json
*.jsonc
*.js
*.cjs
*.mjs
*.ts
*.tsx
*.css
*.html

# packages/website: Waku/fumadocs-mdx codegen output
.source/

# packages/website: generated docs mirror (sync-docs-from-engine.mjs, sync-kit-pages.mjs).
# Gitignored build output, but listed here too: the website's format scripts pass an
# explicit --ignore-path, which turns off Prettier's .gitignore lookup. The hand-authored
# hub (content/docs/index.mdx) and root meta stay formatted.
packages/website/content/docs/*/**

# Cursor slash-command mirror (produced verbatim, minus frontmatter, from
# .claude/skills/*/SKILL.md by scripts/sync-cursor-commands.mjs). The generator is the
# single owner of this content; it does not re-wrap prose after re-relativizing links, so
# Prettier's proseWrap can disagree with it on wrap points and make sync:cursor-commands:check
# report drift on files nobody hand-edited.
.cursor/commands/
