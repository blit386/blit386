# Prettier ignore - Markdown and YAML only (TS/JS/JSON/CSS use Biome)

# Lock file (never format)
pnpm-lock.yaml

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/

# Test runner output (generated locally by `test:visual`, gitignored). Formatting
# these makes the next format:check fail on files nobody authored.
playwright-report/
test-results/

# Agent scratch space (not ours to format)
.git/
.remember/
.superpowers/

# Scaffolder ownership manifest and pristine kit copies (create-blit386). Reformatting
# .blit/base/ makes `blit agents sync` report drift on files nobody edited.
.blit/

# packages/website: Waku/fumadocs-mdx codegen output
.source/

# packages/website: generated docs mirror (produced by
# packages/website/scripts/sync-docs-from-engine.mjs from packages/blit386/docs).
# Artifacts: not subject to this repo's format gate. The hand-authored hub
# (content/docs/index.mdx) and root meta stay formatted.
packages/website/content/docs/*/**

# Cursor slash-command mirror (produced verbatim, minus frontmatter, from
# .claude/skills/*/SKILL.md by scripts/sync-cursor-commands.mjs). The generator is the
# single owner of this content; it does not re-wrap prose after re-relativizing links, so
# Prettier's proseWrap can disagree with it on wrap points and make sync:cursor-commands:check
# report drift on files nobody hand-edited.
.cursor/commands/
