{
  "name": "blit386-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "prepare": "husky",
    "format": "biome format --write . && prettier --write \"**/*.{md,mdx,yml,yaml}\"",
    "format:check": "biome check . && prettier --check \"**/*.{md,mdx,yml,yaml}\"",
    "format:biome": "biome format --write .",
    "format:prettier": "prettier --write \"**/*.{md,mdx,yml,yaml}\"",
    "docs:links": "node scripts/check-markdown-links.mjs",
    "test:markdown-links": "node --test scripts/check-markdown-links.test.mjs",
    "agents:check": "node scripts/check-agent-config.mjs",
    "test:agent-config": "node --test scripts/check-agent-config.test.mjs",
    "check-dash-typography": "node scripts/check-dash-typography.mjs",
    "test:dash-typography": "node --test scripts/check-dash-typography.test.mjs",
    "test:compact-tables": "node --test scripts/prettier-plugin-compact-tables.test.mjs",
    "test:shell-safety": "node --test scripts/shell-safety.test.mjs",
    "test:spellcheck-coverage": "node --test scripts/spellcheck-coverage.test.mjs",
    "test:build-lock": "node --test scripts/build-lock.test.mjs",
    "test:ensure-engine-built": "node --test scripts/ensure-engine-built.test.mjs",
    "test:ensure-kit-built": "node --test scripts/ensure-kit-built.test.mjs",
    "test:ci-workflow-benchmark": "node --test scripts/ci-workflow-benchmark.test.mjs",
    "bump": "node scripts/bump-lockstep.mjs",
    "bump:check": "node scripts/bump-lockstep.mjs --check",
    "test:bump-lockstep": "node --test scripts/bump-lockstep.test.mjs",
    "check-kit-docs-drift": "node scripts/check-kit-docs-drift.mjs",
    "test:check-kit-docs-drift": "node --test scripts/check-kit-docs-drift.test.mjs",
    "test:linear-client": "node --test scripts/lib/linear-client.test.mjs",
    "report-kit-docs-drift": "node scripts/report-kit-docs-drift.mjs",
    "test:report-kit-docs-drift": "node --test scripts/report-kit-docs-drift.test.mjs",
    "security:audit": "pnpm audit --audit-level=moderate",
    "security:audit:prod": "pnpm audit --prod --audit-level=moderate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "cspell": "^10.0.1",
    "husky": "^9.1.7",
    "knip": "^6.32.0",
    "lint-staged": "^17.3.0",
    "markdown-link-check": "^3.15.0",
    "prettier": "^3.9.6"
  }
}
