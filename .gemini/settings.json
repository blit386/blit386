{
  "context": {
    "fileName": [
      "AGENTS.md",
      "GEMINI.md"
    ]
  },
  "mcpServers": {
    "blit386-docs": {
      "httpUrl": "https://blit386.dev/mcp"
    }
  },
  "hooks": {
    "AfterTool": [
      {
        "hooks": [
          {
            "name": "format-on-edit",
            "type": "command",
            "command": "node .gemini/hooks/format-file.cjs",
            "timeout": 30000
          }
        ],
        "matcher": "write_file|replace"
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "name": "block-dangerous-shell",
            "type": "command",
            "command": "node -e \"try{require('./.gemini/hooks/shell-guard.cjs')}catch(e){console.error('[BLOCKED] The blit386 guard could not run, so the request was blocked: '+e.message);process.exit(2)}\"",
            "timeout": 10000
          }
        ],
        "matcher": "run_shell_command"
      },
      {
        "hooks": [
          {
            "name": "protect-generated-and-secret-files",
            "type": "command",
            "command": "node -e \"try{require('./.gemini/hooks/protect-files.cjs')}catch(e){console.error('[BLOCKED] The blit386 guard could not run, so the request was blocked: '+e.message);process.exit(2)}\"",
            "timeout": 10000
          }
        ],
        "matcher": "write_file|replace"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "session-start-bootstrap",
            "type": "command",
            "command": "BLIT_PM_INSTALL='pnpm install' sh .gemini/hooks/session-start.sh",
            "timeout": 300000
          }
        ],
        "matcher": "startup"
      }
    ]
  }
}
