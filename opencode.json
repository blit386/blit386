{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "biome": {
      "extensions": [
        ".js",
        ".cjs",
        ".mjs",
        ".ts",
        ".json",
        ".jsonc"
      ]
    },
    "prettier": {
      "extensions": [
        ".md",
        ".mdx",
        ".mdc",
        ".yml",
        ".yaml"
      ]
    }
  },
  "permission": {
    "edit": {
      "pnpm-lock.yaml": "deny",
      "*/pnpm-lock.yaml": "deny",
      "package-lock.json": "deny",
      "*/package-lock.json": "deny",
      "bun.lockb": "deny",
      "*/bun.lockb": "deny",
      "*.lock": "deny",
      ".env": "deny",
      "*/.env": "deny",
      ".env.*": "deny",
      "*/.env.*": "deny",
      ".env.example": "allow",
      "*/.env.example": "allow"
    },
    "read": {
      ".env": "deny",
      "*/.env": "deny",
      ".env.*": "deny",
      "*/.env.*": "deny",
      ".env.example": "allow",
      "*/.env.example": "allow"
    },
    "bash": {
      "git reset *--hard*": "deny",
      "git reset *--h": "deny",
      "git reset *--h *": "deny",
      "git reset *--ha": "deny",
      "git reset *--ha *": "deny",
      "git reset *--har": "deny",
      "git reset *--har *": "deny",
      "git checkout -- *": "deny",
      "git checkout * -- *": "deny",
      "git checkout .": "deny",
      "git checkout * .": "deny",
      "git checkout -f*": "deny",
      "git checkout * -f*": "deny",
      "git checkout *--f*": "deny",
      "git checkout -p*": "deny",
      "git checkout * -p*": "deny",
      "git checkout -2*": "deny",
      "git checkout * -2*": "deny",
      "git checkout -3*": "deny",
      "git checkout * -3*": "deny",
      "git checkout *--pat*": "deny",
      "git checkout *--ou*": "deny",
      "git checkout *--th*": "deny",
      "git checkout *--no-over*": "deny",
      "git switch -f*": "deny",
      "git switch * -f*": "deny",
      "git switch *--f": "deny",
      "git switch *--f *": "deny",
      "git switch *--fo": "deny",
      "git switch *--fo *": "deny",
      "git switch *--for": "deny",
      "git switch *--for *": "deny",
      "git switch *--forc": "deny",
      "git switch *--forc *": "deny",
      "git switch *--force": "deny",
      "git switch *--force *": "deny",
      "git switch *--di*": "deny",
      "git restore *": "deny",
      "git restore --staged *": "allow",
      "git clean": "deny",
      "git clean *": "deny",
      "git clean -n*": "allow",
      "git clean --dry-run*": "allow",
      "git push -f*": "ask",
      "git push * -f*": "ask",
      "git push *--force*": "ask",
      "git push * +*": "ask",
      "git push -uf*": "ask",
      "git push * -uf*": "ask",
      "git push -vf*": "ask",
      "git push * -vf*": "ask",
      "git push -qf*": "ask",
      "git push * -qf*": "ask",
      "git push -nf*": "ask",
      "git push * -nf*": "ask",
      "git push -df*": "ask",
      "git push * -df*": "ask",
      "git push -4f*": "ask",
      "git push * -4f*": "ask",
      "git push -6f*": "ask",
      "git push * -6f*": "ask",
      "git branch -D *": "ask",
      "git branch * -D*": "ask",
      "git branch -df*": "ask",
      "git branch * -df*": "ask",
      "git branch -fd*": "ask",
      "git branch * -fd*": "ask",
      "git branch -d -f*": "ask",
      "git branch * -d -f*": "ask",
      "git branch -f -d*": "ask",
      "git branch * -f -d*": "ask",
      "git branch -d --force*": "ask",
      "git branch * -d --force*": "ask",
      "git branch --force -d*": "ask",
      "git branch * --force -d*": "ask",
      "git branch --delete -f*": "ask",
      "git branch * --delete -f*": "ask",
      "git branch -f --delete*": "ask",
      "git branch * -f --delete*": "ask",
      "git branch --delete --force*": "ask",
      "git branch * --delete --force*": "ask",
      "git branch --force --delete*": "ask",
      "git branch * --force --delete*": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask"
    }
  },
  "mcp": {
    "blit386-docs": {
      "type": "remote",
      "url": "https://blit386.dev/mcp",
      "enabled": true
    }
  }
}
