{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Language and Environment: adds DOM + WebGPU types over the shared base */
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types", "node"],

    /* Interop Constraints */
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*",
    "tests/visual/**/*.ts",
    "vite.config.ts",
    "vite.config.test.ts",
    "vite.node.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
