{
  "name": "blit386",
  "version": "1.5.0",
  "type": "module",
  "description": "A palette-first WebGPU retro engine for TypeScript, inspired by RetroBlit.",
  "author": {
    "name": "Václav Vančura",
    "url": "https://github.com/vancura"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blit386/blit386.git"
  },
  "homepage": "https://blit386.dev",
  "bugs": {
    "url": "https://github.com/blit386/blit386/issues"
  },
  "keywords": [
    "typescript",
    "canvas",
    "game-engine",
    "gamedev",
    "pixel-art",
    "retro",
    "color-palette",
    "sprite",
    "bitmap-font",
    "vga",
    "2d-game",
    "webgpu",
    "fantasy-console",
    "indexed-color",
    "palette-cycling",
    "mode-13h"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "./dist/blit386.cjs",
  "module": "./dist/blit386.js",
  "types": "./dist/blit386.d.ts",
  "exports": {
    ".": {
      "types": "./dist/blit386.d.ts",
      "import": "./dist/blit386.js",
      "require": "./dist/blit386.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build:browser": "vite build",
    "build:node": "vite build --config vite.node.config.ts",
    "build": "pnpm run build:browser && pnpm run build:node",
    "build:check-declarations": "node scripts/check-declaration-tooling.mjs",
    "test:declarations": "node --test scripts/check-declaration-tooling.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "biome format --write . && prettier --ignore-path ../../.prettierignore --write \"**/*.{md,mdx,yml,yaml}\"",
    "format:check": "biome check . && prettier --ignore-path ../../.prettierignore --check \"**/*.{md,mdx,yml,yaml}\"",
    "format:biome": "biome format --write .",
    "format:prettier": "prettier --ignore-path ../../.prettierignore --write \"**/*.{md,mdx,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "spellcheck": "cspell \"src/**/*.{ts,md,mdx}\" \"docs/**/*.{md,mdx}\" \"README.md\" --no-progress --gitignore-root \"$(git rev-parse --show-toplevel)\"",
    "docs:links": "node ../../scripts/check-markdown-links.mjs",
    "agents:check": "node ../../scripts/check-agent-config.mjs",
    "test:agent-config": "node --test ../../scripts/check-agent-config.test.mjs",
    "sync:doc-banners": "node scripts/sync-doc-banners.mjs",
    "sync:doc-banners:check": "node scripts/sync-doc-banners.mjs --check",
    "api:history": "node scripts/gen-api-history.mjs",
    "api:history:check": "node scripts/gen-api-history.mjs --check",
    "api:since:check": "node scripts/gen-api-history.mjs --since-check",
    "api:getters:check": "node scripts/check-api-getters-drift.mjs",
    "test:api-history": "node --test scripts/gen-api-history.test.mjs",
    "test:api-getters": "node --test scripts/check-api-getters-drift.test.mjs",
    "test:compact-tables": "node --test ../../scripts/prettier-plugin-compact-tables.test.mjs",
    "test:shell-safety": "node --test scripts/shell-safety.test.mjs",
    "test:spellcheck-coverage": "node --test ../../scripts/spellcheck-coverage.test.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "test:unit:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "bench:json": "vitest bench --outputJson benchmark-results.json",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:coverage": "VISUAL_COVERAGE=1 playwright test && nyc report --reporter=lcov --reporter=text-summary --temp-dir=.nyc_output --report-dir=coverage-visual",
    "preflight": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run spellcheck && pnpm run knip && pnpm run sync:doc-banners:check && pnpm run api:since:check && pnpm run api:history:check && pnpm run api:getters:check && pnpm run test:unit && pnpm run test:declarations && pnpm run test:agent-config && pnpm run test:api-history && pnpm run test:api-getters && pnpm run test:compact-tables && pnpm run test:shell-safety && pnpm run test:spellcheck-coverage && pnpm run test:security-preflight",
    "clean": "rm -rf dist node_modules/.vite",
    "release": "pnpm run build && pnpm publish",
    "knip": "cd ../.. && knip --workspace packages/blit386 --exclude exports,types",
    "knip:fix": "knip --fix",
    "convert-font": "node scripts/convert-bmfont.mjs",
    "system-font:export": "node scripts/export-system-font.mjs",
    "system-font:convert": "node scripts/convert-system-font.mjs",
    "splash-logo:convert": "node scripts/convert-splash-logo.mjs",
    "prepublishOnly": "pnpm run build",
    "prepare": "husky",
    "security:audit": "pnpm audit --audit-level=moderate",
    "security:audit:prod": "pnpm audit --prod --audit-level=moderate",
    "security:audit:fix": "pnpm audit --fix",
    "security:mcp-preflight": "node scripts/security/mcp-preflight.mjs",
    "test:security-preflight": "node --test scripts/security/mcp-preflight.test.mjs"
  },
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@webgpu/types": "^0.1.71",
    "acorn": "^8.17.0",
    "cspell": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "knip": "^6.32.0",
    "magic-string": "^0.30.21",
    "nyc": "^18.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-istanbul": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
