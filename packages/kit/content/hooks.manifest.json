{
  "version": "1",
  "hooks": [
    {
      "id": "format-on-edit",
      "intent": "Format the one file an AI-assisted edit just changed, to keep code consistent",
      "cursor": {
        "event": "afterFileEdit",
        "command": "node .cursor/hooks/format-file.cjs",
        "matcher": "Write|TabWrite",
        "timeout": 30,
        "failClosed": false
      },
      "claude": {
        "event": "PostToolUse",
        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.cjs\"",
        "matcher": "Edit|MultiEdit|Write",
        "timeout": 30
      },
      "antigravity": {
        "event": "PostToolUse",
        "command": "node .agents/hooks/format-file.cjs",
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "timeout": 30
      }
    },
    {
      "id": "block-dangerous-shell",
      "intent": "Block risky destructive git commands that could lose game progress",
      "cursor": {
        "event": "beforeShellExecution",
        "command": "node .cursor/hooks/shell-safety.cjs",
        "timeout": 10,
        "failClosed": true
      },
      "claude": {
        "event": "PreToolUse",
        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/shell-safety.cjs\"",
        "matcher": "Bash",
        "timeout": 10
      },
      "antigravity": {
        "event": "PreToolUse",
        "command": "node .agents/hooks/antigravity-guard.cjs shell",
        "matcher": "run_command",
        "timeout": 10
      }
    },
    {
      "id": "protect-generated-and-secret-files",
      "intent": "Keep the assistant from hand-editing lock files and .env files",
      "claude": {
        "event": "PreToolUse",
        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.cjs\"",
        "matcher": "Edit|MultiEdit|Write",
        "timeout": 10
      },
      "antigravity": {
        "event": "PreToolUse",
        "command": "node .agents/hooks/antigravity-guard.cjs files",
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "timeout": 10
      }
    },
    {
      "id": "session-start-bootstrap",
      "intent": "Install dependencies and run a checkup when a fresh remote/web session starts, so the game works without manual setup",
      "claude": {
        "event": "SessionStart",
        "command": "cd \"$CLAUDE_PROJECT_DIR\" && BLIT_PM_INSTALL='{{pmInstall}}' sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
        "matcher": "startup|resume|clear|compact|fork",
        "timeout": 300
      },
      "antigravity": {
        "event": "PreInvocation",
        "command": "node .agents/hooks/antigravity-bootstrap.cjs \"{{pmInstall}}\"",
        "timeout": 300
      }
    }
  ]
}
