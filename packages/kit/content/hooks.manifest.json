{
  "version": "1",
  "hooks": [
    {
      "id": "format-on-edit",
      "intent": "Format the one file an AI-assisted edit just changed, to keep code consistent",
      "codex": {
        "event": "PostToolUse",
        "command": "sh -c 'd=$PWD; while [ -n \"$d\" ] && [ ! -f \"$d/.codex/hooks/format-file.cjs\" ]; do d=${d%/*}; done; [ -n \"$d\" ] || exit 0; node \"$d/.codex/hooks/format-file.cjs\"'",
        "matcher": "apply_patch",
        "timeout": 30
      },
      "cursor": {
        "event": "afterFileEdit",
        "command": "node .cursor/hooks/format-file.cjs",
        "matcher": "Write|TabWrite",
        "timeout": 30,
        "failClosed": false
      },
      "claude": {
        "event": "PostToolUse",
        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.cjs\"",
        "matcher": "Edit|MultiEdit|Write",
        "timeout": 30
      },
      "antigravity": {
        "event": "PostToolUse",
        "command": "node .agents/hooks/format-file.cjs",
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "timeout": 30
      },
      "gemini": {
        "event": "AfterTool",
        "command": "node \"$GEMINI_PROJECT_DIR/.gemini/hooks/format-file.cjs\"",
        "matcher": "write_file|replace",
        "timeout": 30000
      },
      "copilot": {
        "event": "postToolUse",
        "command": "node .github/hooks/copilot-hook.cjs post-tool",
        "matcher": "edit|create",
        "timeout": 30
      }
    },
    {
      "id": "block-dangerous-shell",
      "intent": "Block risky destructive git commands that could lose game progress",
      "codex": {
        "event": "PreToolUse",
        "command": "sh -c 'd=$PWD; while [ -n \"$d\" ] && [ ! -f \"$d/.codex/hooks/codex-guard.cjs\" ]; do d=${d%/*}; done; node \"$d/.codex/hooks/codex-guard.cjs\" shell; s=$?; [ $s = 0 ] || [ $s = 2 ] || { echo \"[BLOCKED] The blit386 guard could not run, so the request was blocked.\" >&2; s=2; }; exit $s'",
        "matcher": "Bash",
        "timeout": 10
      },
      "cursor": {
        "event": "beforeShellExecution",
        "command": "node .cursor/hooks/shell-safety.cjs",
        "timeout": 10,
        "failClosed": true
      },
      "claude": {
        "event": "PreToolUse",
        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/shell-safety.cjs\"",
        "matcher": "Bash",
        "timeout": 10
      },
      "antigravity": {
        "event": "PreToolUse",
        "command": "node .agents/hooks/antigravity-guard.cjs shell",
        "matcher": "run_command",
        "timeout": 10
      },
      "gemini": {
        "event": "BeforeTool",
        "command": "node \"$GEMINI_PROJECT_DIR/.gemini/hooks/shell-guard.cjs\"",
        "matcher": "run_shell_command",
        "timeout": 10000
      },
      "opencode": {
        "event": "tool.execute.before",
        "scripts": ["guard-core.cjs"]
      },
      "copilot": {
        "event": "preToolUse",
        "command": "node .github/hooks/copilot-hook.cjs pre-tool",
        "matcher": "bash|powershell",
        "timeout": 10
      }
    },
    {
      "id": "protect-generated-and-secret-files",
      "intent": "Keep the assistant from hand-editing lock files and .env files",
      "codex": {
        "event": "PreToolUse",
        "command": "sh -c 'd=$PWD; while [ -n \"$d\" ] && [ ! -f \"$d/.codex/hooks/codex-guard.cjs\" ]; do d=${d%/*}; done; node \"$d/.codex/hooks/codex-guard.cjs\" patch; s=$?; [ $s = 0 ] || [ $s = 2 ] || { echo \"[BLOCKED] The blit386 guard could not run, so the request was blocked.\" >&2; s=2; }; exit $s'",
        "matcher": "apply_patch",
        "timeout": 10
      },
      "claude": {
        "event": "PreToolUse",
        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.cjs\"",
        "matcher": "Edit|MultiEdit|Write",
        "timeout": 10
      },
      "antigravity": {
        "event": "PreToolUse",
        "command": "node .agents/hooks/antigravity-guard.cjs files",
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "timeout": 10
      },
      "gemini": {
        "event": "BeforeTool",
        "command": "node \"$GEMINI_PROJECT_DIR/.gemini/hooks/protect-files.cjs\"",
        "matcher": "write_file|replace",
        "timeout": 10000
      },
      "opencode": {
        "event": "tool.execute.before",
        "scripts": ["guard-core.cjs"]
      },
      "copilot": {
        "event": "preToolUse",
        "command": "node .github/hooks/copilot-hook.cjs pre-tool",
        "matcher": "edit|create",
        "timeout": 10
      }
    },
    {
      "id": "session-start-bootstrap",
      "intent": "Install dependencies and run a checkup when a fresh remote/web session starts, so the game works without manual setup",
      "codex": {
        "event": "SessionStart",
        "command": "sh -c 'd=$PWD; while [ -n \"$d\" ] && [ ! -f \"$d/.codex/hooks/session-start.sh\" ]; do d=${d%/*}; done; [ -n \"$d\" ] || exit 0; cd \"$d\" && BLIT_PM_INSTALL=\"{{pmInstall}}\" sh .codex/hooks/session-start.sh'",
        "matcher": "startup",
        "timeout": 300
      },
      "claude": {
        "event": "SessionStart",
        "command": "cd \"$CLAUDE_PROJECT_DIR\" && BLIT_PM_INSTALL='{{pmInstall}}' sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
        "matcher": "startup|resume|clear|compact|fork",
        "timeout": 300
      },
      "antigravity": {
        "event": "PreInvocation",
        "command": "node .agents/hooks/antigravity-bootstrap.cjs \"{{pmInstall}}\"",
        "timeout": 300
      },
      "gemini": {
        "event": "SessionStart",
        "command": "cd \"$GEMINI_PROJECT_DIR\" && BLIT_PM_INSTALL='{{pmInstall}}' sh \"$GEMINI_PROJECT_DIR/.gemini/hooks/session-start.sh\"",
        "matcher": "startup",
        "timeout": 300000
      },
      "opencode": {
        "event": "session.created",
        "scripts": ["session-start.sh"]
      },
      "copilot": {
        "event": "sessionStart",
        "command": "node .github/hooks/copilot-hook.cjs session-start \"{{pmInstall}}\"",
        "timeout": 300
      }
    }
  ]
}
