{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blit386",
  "main": "./src/waku.server",
  "compatibility_flags": ["nodejs_als"],
  "compatibility_date": "2026-06-20",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/public",
    "html_handling": "drop-trailing-slash",
    // Run the Worker first so Accept: text/markdown negotiation can intercept canonical
    // doc URLs; the Worker re-serves static assets via the ASSETS binding. The deployed
    // config (dist/server/wrangler.json) is regenerated by Waku, so scripts/patch-wrangler.mjs
    // injects this same flag there.
    "run_worker_first": true
  },
  // Workers Logs: blit386.dev is production with a live JSON-RPC endpoint (/mcp) and a
  // request-time markdown-negotiation path. Same parity story as run_worker_first above:
  // scripts/patch-wrangler.mjs injects this into the deployed dist/server/wrangler.json.
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "no_bundle": true
}
