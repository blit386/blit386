{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["dom", "dom.iterable", "ES2023"],
    "types": ["mdx", "node", "react", "react-dom"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "sourceMap": false,
    /* The one base check still off: turning it on costs 44 errors, mostly in tests (BT-784). */
    "exactOptionalPropertyTypes": false
  },
  "include": ["src", "content", "*.ts", "*.tsx", "scripts/__tests__"],
  "exclude": ["node_modules", "dist", ".source"]
}
