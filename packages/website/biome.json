{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "root": false,
  "extends": ["../../biome.json"],
  "files": {
    "includes": [
      "src/**/*.{ts,tsx,css}",
      "*.{ts,tsx}",
      "content/**/meta.json",
      "scripts/**/*.mjs",
      "*.json",
      "*.jsonc",
      "!content/docs/*"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": ["src/data/api-history.generated.json"],
      "json": {
        "formatter": {
          "expand": "always"
        }
      }
    }
  ]
}
