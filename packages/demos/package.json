{
  "name": "blit386-demos",
  "private": true,
  "type": "module",
  "description": "Interactive demos for BLIT386, a palette-first WebGPU retro engine for TypeScript.",
  "author": {
    "name": "Václav Vančura",
    "url": "https://github.com/vancura"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blit386/blit386.git",
    "directory": "packages/demos"
  },
  "homepage": "https://demos.blit386.dev",
  "keywords": [
    "blit386",
    "webgpu",
    "javascript",
    "demos",
    "examples",
    "game-engine",
    "retro",
    "pixel-art",
    "2d-game",
    "2d-demo",
    "sprite",
    "canvas",
    "fantasy-console"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:watch": "pnpm --filter blit386 run build && concurrently -n \"lib,demos\" -c \"blue,green\" \"pnpm --filter blit386 run build:browser --watch\" \"pnpm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "biome format --write . && prettier --ignore-path ../../.prettierignore --write \"**/*.{md,mdx,yml,yaml}\"",
    "format:check": "biome check . && prettier --ignore-path ../../.prettierignore --check \"**/*.{md,mdx,yml,yaml}\"",
    "format:biome": "biome format --write .",
    "format:prettier": "prettier --ignore-path ../../.prettierignore --write \"**/*.{md,mdx,yml,yaml}\"",
    "spellcheck": "cspell \"src/**/*.{js,md,mdx}\" \"docs/**/*.{md,mdx}\" \"README.md\" --no-progress --gitignore-root \"$(git rev-parse --show-toplevel)\"",
    "docs:links": "node ../../scripts/check-markdown-links.mjs",
    "check:demo-registry": "node scripts/check-demo-registry.mjs",
    "generate:audio-loops": "node scripts/generate-audio-loops.mjs",
    "preflight": "pnpm run format:check && pnpm run lint && pnpm run spellcheck && pnpm run knip && pnpm run check:demo-registry && pnpm run build",
    "knip": "cd ../.. && knip --workspace packages/demos",
    "knip:fix": "knip --fix",
    "clean": "rm -rf dist node_modules/.vite",
    "prepare": "husky",
    "security:audit": "pnpm audit --audit-level=moderate",
    "security:audit:fix": "pnpm audit --fix",
    "security:mcp-preflight": "node ../blit386/scripts/security/mcp-preflight.mjs"
  },
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "blit386": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@eslint/js": "^10.0.1",
    "@shikijs/twoslash": "^4.3.1",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "cspell": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "knip": "^6.31.0",
    "postcss-nesting": "^14.0.1",
    "prettier": "^3.9.6",
    "shiki": "^4.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
