{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "root": false,
  "extends": ["../../biome.json"],
  "files": {
    "includes": [
      "src/**/*.{ts,tsx,css}",
      "*.{ts,tsx}",
      "content/**/meta.json",
      "scripts/**/*.mjs",
      ".claude/**/*.json",
      ".github/**/*.json",
      "*.json",
      "*.jsonc",
      "commitlint.config.js",
      "prettier.config.js",
      "!content/docs/*"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "style": {
        "noNonNullAssertion": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  }
}
