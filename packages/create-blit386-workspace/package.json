{
  "name": "create-blit386-workspace",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for the BLIT386 scaffolder (create-blit386) and kit (@blit386/kit).",
  "author": {
    "name": "Václav Vančura",
    "url": "https://github.com/vancura"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blit386/create-blit386.git"
  },
  "homepage": "https://blit386.dev",
  "bugs": {
    "url": "https://github.com/blit386/create-blit386/issues"
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write . && prettier --ignore-path ../../.prettierignore --write \"**/*.{md,mdx,yml,yaml}\"",
    "format:check": "biome format . && prettier --ignore-path ../../.prettierignore --check \"**/*.{md,mdx,yml,yaml}\"",
    "spellcheck": "cspell \"packages/*/src/**/*.ts\" \"packages/*/README.md\" \"packages/kit/content/**/*.md\" \".claude/skills/**/*.md\" \".claude/rules/**/*.md\" \"README.md\" \"CLAUDE.md\" \"CONTRIBUTING.md\" \"CODE_OF_CONDUCT.md\" \"CREATE_BLIT386_DESIGN.md\" \"PUBLISHING.md\" --no-progress",
    "docs:links": "node ../../scripts/check-markdown-links.mjs",
    "agents:check": "node ../../scripts/check-agent-config.mjs",
    "bump": "node scripts/bump-lockstep.mjs",
    "test:agent-config": "node --test ../../scripts/check-agent-config.test.mjs",
    "test:bump-lockstep": "node --test scripts/bump-lockstep.test.mjs",
    "test:compact-tables": "node --test ../../scripts/prettier-plugin-compact-tables.test.mjs",
    "test:shell-safety": "node --test scripts/shell-safety.test.mjs",
    "knip": "cd ../.. && knip --workspace packages/create-blit386 --workspace packages/kit",
    "knip:fix": "knip --fix",
    "security:audit": "pnpm audit --audit-level=moderate",
    "security:audit:prod": "pnpm audit --prod --audit-level=moderate",
    "security:audit:fix": "pnpm audit --fix",
    "preflight": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run spellcheck && pnpm run knip && pnpm run docs:links && pnpm run agents:check && pnpm run test:agent-config && pnpm run test:bump-lockstep && pnpm run test:compact-tables && pnpm run test:shell-safety && pnpm run build && pnpm run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "cspell": "^10.0.1",
    "husky": "^9.1.7",
    "knip": "^6.26.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
