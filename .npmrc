# Supply-chain hardening for pnpm 10.
minimum-release-age=10080
minimum-release-age-exclude[]=ws
minimum-release-age-exclude[]=brace-expansion
minimum-release-age-exclude[]=postcss
minimum-release-age-exclude[]=uuid
minimum-release-age-exclude[]=fast-uri
minimum-release-age-exclude[]=undici
minimum-release-age-exclude[]=@types/node
minimum-release-age-exclude[]=@commitlint/cli
minimum-release-age-exclude[]=@commitlint/config-conventional
minimum-release-age-exclude[]=cspell
minimum-release-age-exclude[]=knip
minimum-release-age-exclude[]=lint-staged
minimum-release-age-exclude[]=markdown-link-check
minimum-release-age-exclude[]=husky
# Transitive dependencies of markdown-link-check; excluded because installs stalled on them.
minimum-release-age-exclude[]=chalk
minimum-release-age-exclude[]=link-check
minimum-release-age-exclude[]=markdown-link-extractor
# packages/website: Fumapress/Waku/Fumadocs pull transitive deps (Takumi, Hono,
# lucide-react) that publish more often than the 7-day gate tolerates. Extend this
# list rather than weaken the window if installs stall on a new fast-moving dep.
minimum-release-age-exclude[]=waku
minimum-release-age-exclude[]=fumadocs
minimum-release-age-exclude[]=fumapress
minimum-release-age-exclude[]=takumi
minimum-release-age-exclude[]=hono
minimum-release-age-exclude[]=lucide-react
block-exotic-subdeps=true
strict-dep-builds=true
