# pnpm 11 only reads auth and registry settings from .npmrc; everything else lives in
# pnpm-workspace.yaml (minimumReleaseAge: 10080, i.e. 7 days). Auth tokens and scoped
# registries come from the user-level npmrc.
#
# npm is not a supported package manager for this workspace - use pnpm. min-release-age
# below is npm's equivalent gate for anyone who runs plain npm against this file anyway,
# but it is not a reliable substitute for pnpm-workspace.yaml's minimumReleaseAge: npm
# only recognizes min-release-age from 11.10.0 onward, and Node >=22.18.0 (this repo's
# floor) bundles npm 10.9.x, which silently ignores it.
min-release-age=7
