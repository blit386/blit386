{
  "context_servers": {
    "blit386-docs": { "url": "https://blit386.dev/mcp" }
  },

  "languages": {
    "TypeScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": { "source.fixAll.biome": true },
      "format_on_save": "on"
    },

    "TSX": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": { "source.fixAll.biome": true },
      "format_on_save": "on"
    },

    "JavaScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": { "source.fixAll.biome": true },
      "format_on_save": "on"
    },

    "JSON": {
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on"
    },

    "JSONC": {
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on"
    },

    "CSS": {
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on"
    },

    "Markdown": {
      "language_servers": ["!markdownlint", "..."],
      "prettier": { "parser": "markdown-compact" },
      "formatter": "prettier",
      "format_on_save": "on"
    },

    "MDX": {
      "prettier": { "parser": "markdown-compact" },
      "formatter": "prettier",
      "format_on_save": "on"
    },

    "YAML": {
      "formatter": "prettier",
      "format_on_save": "on"
    }
  }
}
