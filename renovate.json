{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    ":gitSignOff"
  ],
  "timezone": "Europe/Prague",
  "schedule": ["before 6am on Monday"],
  "rangeStrategy": "bump",
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 4,
  "automerge": false,
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "Core build tools",
      "matchPackageNames": ["vite", "typescript", "tsup"],
      "groupName": "core build tools"
    },
    {
      "description": "Vite plugins",
      "matchPackageNames": ["vite-plugin-*"],
      "groupName": "vite plugins"
    },
    {
      "description": "Fumapress, Waku, Fumadocs, and React move as one PR: fumapress declares waku as an exact-version peer dependency (0.7.3 requires exactly waku 1.0.0-beta.6), so splitting these into separate groups produces two PRs, neither installable on its own. See packages/website/CLAUDE.md, Dependency pins",
      "matchPackageNames": [
        "fumapress",
        "waku",
        "fumadocs-core",
        "fumadocs-mdx",
        "fumadocs-ui",
        "react",
        "react-dom",
        "react-server-dom-webpack"
      ],
      "groupName": "fumapress waku react"
    },
    {
      "description": "Tailwind CSS",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/vite"],
      "groupName": "tailwind"
    },
    {
      "description": "Linting and formatting tools",
      "matchPackageNames": [
        "eslint",
        "prettier",
        "@biomejs/biome",
        "cspell",
        "knip",
        "@eslint/*",
        "eslint-config-*",
        "eslint-plugin-*",
        "@typescript-eslint/*"
      ],
      "groupName": "linting and formatting"
    },
    {
      "description": "TypeScript type definitions",
      "matchPackageNames": ["@types/*"],
      "groupName": "type definitions"
    },
    {
      "description": "Do not bump workflow pnpm/node pins or .node-version separately from packageManager/engines",
      "matchManagers": ["github-actions", "nodenv"],
      "matchPackageNames": ["node", "pnpm"],
      "enabled": false
    },
    {
      "description": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "wrangler moves as one PR across npm (packages/website devDependency) and the wranglerVersion regex manager (deploy.yml), or the local and deployed wrangler drift",
      "matchPackageNames": ["wrangler"],
      "groupName": "wrangler"
    },
    {
      "description": "All patches - automerge",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Major updates - manual review with high priority",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-update"]
    },
    {
      "description": "Pin pnpm version",
      "matchPackageNames": ["pnpm"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Held back by 4dfefde3: knip 6.45.1 loads packages/demos/vite.config.js, which imports the engine dist that CI's engine-only job never builds. Remove once that job builds the engine or knip stops evaluating the demos config",
      "matchFileNames": ["packages/blit386/package.json"],
      "matchPackageNames": ["knip"],
      "enabled": false
    },
    {
      "description": "Held back by 4dfefde3: newer fumadocs, react, takumi-js and tailwind crashed the production Cloudflare Worker on boot (takumi wasm loader, \"Invalid URL string\"), which CI does not catch. Remove once that is root-caused",
      "matchFileNames": ["packages/website/package.json"],
      "matchPackageNames": [
        "fumadocs-core",
        "fumadocs-mdx",
        "fumadocs-ui",
        "react",
        "react-dom",
        "takumi-js",
        "tailwindcss",
        "@tailwindcss/vite"
      ],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"],
    "commitMessageAction": "lock file maintenance",
    "commitMessageTopic": "",
    "commitMessageExtra": ""
  },
  "postUpdateOptions": ["pnpmDedupe"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "wrangler-action wranglerVersion pins in deploy.yml, which the github-actions manager does not read",
      "managerFilePatterns": ["/^\\.github/workflows/deploy\\.yml$/"],
      "matchStrings": ["wranglerVersion: '(?<currentValue>[^']+)'"],
      "depNameTemplate": "wrangler",
      "datasourceTemplate": "npm"
    }
  ]
}
